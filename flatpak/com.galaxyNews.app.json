{
  "id": "com.galaxyNews.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "45",
  "sdk": "org.gnome.Sdk",
  "command": "galaxynews",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "galaxynews",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin",
        "cp -r build/linux/x64/release/bundle/* /app/bin/",
        "ln -s /app/bin/rssreader /app/bin/galaxynews"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../"
        }
      ]
    }
  ]
}
